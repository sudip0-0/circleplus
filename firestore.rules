rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function circlePath(circleId) {
      return /databases/$(database)/documents/circles/$(circleId);
    }

    function planPath(circleId, planId) {
      return /databases/$(database)/documents/circles/$(circleId)/plans/$(planId);
    }

    function memberPath(circleId, userId) {
      return /databases/$(database)/documents/circles/$(circleId)/members/$(userId);
    }

    function planResponsePath(circleId, planId, userId) {
      return /databases/$(database)/documents/circles/$(circleId)/plans/$(planId)/responses/$(userId);
    }

    function inviteCodePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    function isCircleMember(circleId) {
      return signedIn() && exists(memberPath(circleId, request.auth.uid));
    }

    function isJoiningCircle(circleId) {
      return signedIn()
        && !exists(memberPath(circleId, request.auth.uid))
        && getAfter(memberPath(circleId, request.auth.uid)).data.userId == request.auth.uid
        && getAfter(memberPath(circleId, request.auth.uid)).data.role == 'member';
    }

    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    function validInviteCode(code) {
      return code.matches('^[A-Z0-9]{6}$');
    }

    function responseCountValue(response, value) {
      return response == value ? 1 : 0;
    }

    function validPlanCountUpdate(circleId, planId) {
      let responsePath = planResponsePath(circleId, planId, request.auth.uid);
      let previousResponse = exists(responsePath) ? get(responsePath).data.response : '';
      let nextResponse = getAfter(responsePath).data.response;
      return isCircleMember(circleId)
        && getAfter(responsePath).data.userId == request.auth.uid
        && nextResponse in ['in', 'maybe', 'cant']
        && request.resource.data.inCount == resource.data.inCount
          + responseCountValue(nextResponse, 'in')
          - responseCountValue(previousResponse, 'in')
        && request.resource.data.maybeCount == resource.data.maybeCount
          + responseCountValue(nextResponse, 'maybe')
          - responseCountValue(previousResponse, 'maybe')
        && request.resource.data.cantCount == resource.data.cantCount
          + responseCountValue(nextResponse, 'cant')
          - responseCountValue(previousResponse, 'cant');
    }

    function validPlanCountsAfterResponse(circleId, planId, userId) {
      let responsePath = planResponsePath(circleId, planId, userId);
      let previousResponse = exists(responsePath) ? get(responsePath).data.response : '';
      let nextResponse = request.resource.data.response;
      return getAfter(planPath(circleId, planId)).data.inCount == get(planPath(circleId, planId)).data.inCount
          + responseCountValue(nextResponse, 'in')
          - responseCountValue(previousResponse, 'in')
        && getAfter(planPath(circleId, planId)).data.maybeCount == get(planPath(circleId, planId)).data.maybeCount
          + responseCountValue(nextResponse, 'maybe')
          - responseCountValue(previousResponse, 'maybe')
        && getAfter(planPath(circleId, planId)).data.cantCount == get(planPath(circleId, planId)).data.cantCount
          + responseCountValue(nextResponse, 'cant')
          - responseCountValue(previousResponse, 'cant');
    }

    match /users/{userId} {
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && request.resource.data.id == userId;

      allow update: if isSelf(userId)
        && request.resource.data.id == userId;

      allow delete: if false;
    }

    match /inviteCodes/{code} {
      allow get: if signedIn() && validInviteCode(code);
      allow list: if false;

      allow create: if signedIn()
        && validInviteCode(code)
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(circlePath(request.resource.data.circleId)).data.createdBy == request.auth.uid;

      allow update, delete: if false;
    }

    match /circles/{circleId} {
      allow read: if isCircleMember(circleId);

      allow create: if signedIn()
        && request.resource.data.id == circleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1;

      allow update: if (
          signedIn()
          && changedOnly(['memberCount', 'updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && isJoiningCircle(circleId)
        ) || (
          isCircleMember(circleId)
          && changedOnly(['lastMessageText', 'lastMessageAt', 'updatedAt'])
        );

      allow delete: if false;

      match /members/{userId} {
        allow read: if isCircleMember(circleId);

        allow create: if isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.circleId == circleId
          && (
            (
              request.resource.data.role == 'creator'
              && getAfter(circlePath(circleId)).data.createdBy == userId
            ) || (
              request.resource.data.role == 'member'
              && request.resource.data.inviteCodeUsed is string
              && validInviteCode(request.resource.data.inviteCodeUsed)
              && get(inviteCodePath(request.resource.data.inviteCodeUsed)).data.circleId == circleId
            )
          );

        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if isCircleMember(circleId);

        allow create: if isCircleMember(circleId)
          && request.resource.data.id == messageId
          && request.resource.data.circleId == circleId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'photo', 'system'];

        allow update, delete: if false;
      }

      match /pulses/{pulseId} {
        allow read: if isCircleMember(circleId);

        allow create, update: if isCircleMember(circleId)
          && request.resource.data.id == pulseId
          && request.resource.data.circleId == circleId
          && request.resource.data.userId == request.auth.uid
          && pulseId.matches('^[0-9]{8}_' + request.auth.uid + '$');

        allow delete: if isCircleMember(circleId)
          && resource.data.userId == request.auth.uid;
      }

      match /plans/{planId} {
        allow read: if isCircleMember(circleId);

        allow create: if isCircleMember(circleId)
          && request.resource.data.id == planId
          && request.resource.data.circleId == circleId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'active';

        allow update: if changedOnly(['inCount', 'maybeCount', 'cantCount', 'updatedAt'])
          && validPlanCountUpdate(circleId, planId);

        allow delete: if false;

        match /responses/{userId} {
          allow read: if isCircleMember(circleId);

          allow create, update: if isCircleMember(circleId)
            && isSelf(userId)
            && request.resource.data.userId == userId
            && request.resource.data.response in ['in', 'maybe', 'cant']
            && validPlanCountsAfterResponse(circleId, planId, userId);

          allow delete: if false;
        }
      }
    }

    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
