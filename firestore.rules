rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Auth helpers ────────────────────────────────────────────────────────

    function signedIn() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ─── Path helpers ─────────────────────────────────────────────────────────

    function circlePath(circleId) {
      return /databases/$(database)/documents/circles/$(circleId);
    }

    function memberPath(circleId, userId) {
      return /databases/$(database)/documents/circles/$(circleId)/members/$(userId);
    }

    function planPath(circleId, planId) {
      return /databases/$(database)/documents/circles/$(circleId)/plans/$(planId);
    }

    function planResponsePath(circleId, planId, userId) {
      return /databases/$(database)/documents/circles/$(circleId)/plans/$(planId)/responses/$(userId);
    }

    function inviteCodePath(code) {
      return /databases/$(database)/documents/inviteCodes/$(code);
    }

    // ─── Membership helpers ───────────────────────────────────────────────────

    // True when the Circle exists and is not soft-deleted. Missing `status`
    // is treated as active for legacy documents (map.get default).
    function isActiveCircle(circleId) {
      return exists(circlePath(circleId))
        && get(circlePath(circleId)).data.get('status', 'active') != 'deleted';
    }

    // True when the signed-in user has a member document in an active Circle.
    // Soft-deleted Circles deny membership-gated access even if member docs
    // remain (tombstone + orphan hardening).
    function isCircleMember(circleId) {
      return signedIn()
        && isActiveCircle(circleId)
        && exists(memberPath(circleId, request.auth.uid));
    }

    // True during a batch/transaction where the user is simultaneously creating
    // their own member document (role = 'member', not yet in the Circle).
    function isJoiningCircle(circleId) {
      return signedIn()
        && !exists(memberPath(circleId, request.auth.uid))
        && getAfter(memberPath(circleId, request.auth.uid)).data.userId == request.auth.uid
        && getAfter(memberPath(circleId, request.auth.uid)).data.role == 'member';
    }

    // ─── Field-change guard ───────────────────────────────────────────────────

    // Ensure only the listed keys are changed in an update.
    function changedOnly(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }

    // ─── Invite code helpers ──────────────────────────────────────────────────

    function validInviteCode(code) {
      return code.matches('^[A-Z0-9]{6}$');
    }

    // ─── Plan response-count helpers ──────────────────────────────────────────

    function responseValue(r, target) {
      return r == target ? 1 : 0;
    }

    // Called when the PLAN document is updated as part of a response transaction.
    // Verifies the count deltas are exactly correct given the previous and next
    // response values that are staged in the same commit.
    function validPlanCountUpdate(circleId, planId) {
      let rPath = planResponsePath(circleId, planId, request.auth.uid);
      let prev  = exists(rPath) ? get(rPath).data.response : '';
      let next  = getAfter(rPath).data.response;
      return isCircleMember(circleId)
        && resource.data.status == 'active'
        && getAfter(rPath).data.userId == request.auth.uid
        && next in ['in', 'maybe', 'cant']
        && request.resource.data.inCount    == resource.data.inCount
             + responseValue(next, 'in')    - responseValue(prev, 'in')
        && request.resource.data.maybeCount == resource.data.maybeCount
             + responseValue(next, 'maybe') - responseValue(prev, 'maybe')
        && request.resource.data.cantCount  == resource.data.cantCount
             + responseValue(next, 'cant')  - responseValue(prev, 'cant');
    }

    // Called when the RESPONSE document is written.
    // Verifies the corresponding plan document counts are staged correctly.
    function validPlanCountsAfterResponse(circleId, planId, userId) {
      let rPath = planResponsePath(circleId, planId, userId);
      let prev  = exists(rPath) ? get(rPath).data.response : '';
      let next  = request.resource.data.response;
      return get(planPath(circleId, planId)).data.status == 'active'
        && getAfter(planPath(circleId, planId)).data.inCount ==
          get(planPath(circleId, planId)).data.inCount
          + responseValue(next, 'in')    - responseValue(prev, 'in')
        && getAfter(planPath(circleId, planId)).data.maybeCount ==
          get(planPath(circleId, planId)).data.maybeCount
          + responseValue(next, 'maybe') - responseValue(prev, 'maybe')
        && getAfter(planPath(circleId, planId)).data.cantCount ==
          get(planPath(circleId, planId)).data.cantCount
          + responseValue(next, 'cant')  - responseValue(prev, 'cant');
    }


    // Pulse denorm on Circle: count may stay the same (caption edit) or +1
    // (first Pulse today), or reset to 1 when the date key rolls.
    function validPulseDenormUpdate(circleId) {
      let dateKey = request.resource.data.todayPulseDateKey;
      let pulseId = dateKey + '_' + request.auth.uid;
      let pPath = /databases/$(database)/documents/circles/$(circleId)/pulses/$(pulseId);
      return isCircleMember(circleId)
        && dateKey is string
        && dateKey.matches('^[0-9]{8}$')
        && request.resource.data.todayPulseCount is int
        && request.resource.data.todayPulseCount >= 1
        && existsAfter(pPath)
        && getAfter(pPath).data.userId == request.auth.uid
        && getAfter(pPath).data.dateKey == dateKey
        && (
          (
            resource.data.get('todayPulseDateKey', '') == dateKey
            && (
              request.resource.data.todayPulseCount
                == resource.data.get('todayPulseCount', 0)
              || request.resource.data.todayPulseCount
                == resource.data.get('todayPulseCount', 0) + 1
            )
          )
          || (
            resource.data.get('todayPulseDateKey', '') != dateKey
            && request.resource.data.todayPulseCount == 1
          )
        );
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /users/{userId}
    // ─────────────────────────────────────────────────────────────────────────

    match /users/{userId} {
      // Users can only read and write their own profile.
      allow read: if isSelf(userId);

      allow create: if isSelf(userId)
        && request.resource.data.id == userId
        // Require mandatory fields to be present on creation.
        && request.resource.data.displayName is string
        && request.resource.data.email is string;

      allow update: if isSelf(userId)
        && request.resource.data.id == userId
        // Prevent escalation: id and email must not be changed.
        && request.resource.data.id == resource.data.id
        && request.resource.data.email == resource.data.email;

      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /inviteCodes/{code}
    // ─────────────────────────────────────────────────────────────────────────

    match /inviteCodes/{code} {
      // Any signed-in user may look up a valid invite code (needed for join flow).
      allow get: if signedIn() && validInviteCode(code);

      // Listing all invite codes is forbidden.
      allow list: if false;

      // Only the Circle creator may create invite codes, proven atomically
      // by requiring the Circle document to be created in the same batch.
      allow create: if signedIn()
        && validInviteCode(code)
        && request.resource.data.code == code
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.circleId is string
        && getAfter(circlePath(request.resource.data.circleId)).data.createdBy == request.auth.uid;

      // Invite codes are immutable and cannot be deleted.
      allow update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────────────────
    // /circles/{circleId}
    // ─────────────────────────────────────────────────────────────────────────

    match /circles/{circleId} {
      // Only members can see the Circle document.
      allow read: if isCircleMember(circleId);

      // Create: the requesting user must be the declared creator and must
      // seed memberCount = 1 atomically. New Circles are created active.
      allow create: if signedIn()
        && request.resource.data.id == circleId
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.memberCount == 1
        && request.resource.data.status == 'active'
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 64;

      // Update: four permitted cases only.
      //
      // Case 1 – Join increment: a user is atomically joining and bumps
      //           memberCount by exactly 1 (active Circles only).
      // Case 2 – Last-message update: any member may update the lastMessage
      //           preview fields after sending a message.
      // Case 3 – Leave decrement: a member is removing themselves and drops
      //           memberCount by exactly 1.
      // Case 4 – Soft-delete tombstone: last-member creator sets status deleted.
      allow update: if (
          signedIn()
          && isActiveCircle(circleId)
          && changedOnly(['memberCount', 'updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount + 1
          && isJoiningCircle(circleId)
        ) || (
          isCircleMember(circleId)
          && changedOnly(['lastMessageText', 'lastMessageAt', 'updatedAt'])
        ) || (
          isCircleMember(circleId)
          && changedOnly(['memberCount', 'updatedAt'])
          && request.resource.data.memberCount == resource.data.memberCount - 1
          && !existsAfter(memberPath(circleId, request.auth.uid))
        ) || (
          isCircleMember(circleId)
          && resource.data.createdBy == request.auth.uid
          && resource.data.memberCount == 1
          && changedOnly(['status', 'updatedAt'])
          && request.resource.data.status == 'deleted'
        ) || (
          changedOnly(['todayPulseDateKey', 'todayPulseCount', 'updatedAt'])
          && validPulseDenormUpdate(circleId)
        );

      // Hard delete from the client is disabled; use soft-delete Case 4.
      allow delete: if false;

      // ── /circles/{circleId}/members/{userId} ─────────────────────────────

      match /members/{userId} {
        // All members can read the member list (needed for member-list screen).
        allow read: if isCircleMember(circleId);

        // Create: two cases.
        //
        // Case 1 – Creator: user is creating the Circle in the same batch
        //          (getAfter verifies the circle.createdBy == userId).
        // Case 2 – Joining member: must supply a valid invite code that
        //          resolves to this Circle.
        allow create: if isSelf(userId)
          && request.resource.data.userId == userId
          && request.resource.data.circleId == circleId
          && (
            (
              request.resource.data.role == 'creator'
              && getAfter(circlePath(circleId)).data.createdBy == userId
            ) || (
              request.resource.data.role == 'member'
              && isActiveCircle(circleId)
              && request.resource.data.inviteCodeUsed is string
              && validInviteCode(request.resource.data.inviteCodeUsed)
              && get(inviteCodePath(request.resource.data.inviteCodeUsed)).data.circleId == circleId
              // Join must bump memberCount by exactly 1 in the same commit.
              && getAfter(circlePath(circleId)).data.memberCount
                == get(circlePath(circleId)).data.memberCount + 1
            )
          );

        // Update is forbidden (membership fields are immutable).
        allow update: if false;

        // Delete: two cases.
        //
        // Case 1 – Leave: member removes themselves and the Circle memberCount
        //          is decremented by exactly 1 in the same transaction.
        // Case 2 – Soft-delete: last-member creator removes membership while
        //          the Circle is tombstoned (status → deleted) in the same
        //          transaction.
        allow delete: if isSelf(userId)
          && isCircleMember(circleId)
          && (
            (
              getAfter(circlePath(circleId)).data.memberCount
                == get(circlePath(circleId)).data.memberCount - 1
            ) || (
              getAfter(circlePath(circleId)).data.status == 'deleted'
              && get(circlePath(circleId)).data.createdBy == request.auth.uid
              && get(circlePath(circleId)).data.memberCount == 1
            )
          );
      }

      // ── /circles/{circleId}/messages/{messageId} ─────────────────────────

      match /messages/{messageId} {
        // Only Circle members can read messages.
        allow read: if isCircleMember(circleId);

        // Only Circle members can send messages; sender identity is enforced.
        allow create: if isCircleMember(circleId)
          && request.resource.data.id == messageId
          && request.resource.data.circleId == circleId
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.type in ['text', 'photo', 'system']
          // Prevent empty text messages.
          && (
            request.resource.data.type != 'text'
            || (
              request.resource.data.text is string
              && request.resource.data.text.size() >= 1
            )
          )
          // Photo messages must supply a mediaUrl.
          && (
            request.resource.data.type != 'photo'
            || request.resource.data.mediaUrl is string
          );

        // The sender may soft-delete their own message (type → 'deleted',
        // text/mediaUrl cleared). Only those four fields may change.
        allow update: if isCircleMember(circleId)
          && resource.data.senderId == request.auth.uid
          && changedOnly(['type', 'text', 'mediaUrl', 'deletedAt'])
          && request.resource.data.type == 'deleted'
          && !('text' in request.resource.data)
          && !('mediaUrl' in request.resource.data);

        // Messages cannot be hard-deleted via the client.
        allow delete: if false;
      }

      // ── /circles/{circleId}/pulses/{pulseId} ─────────────────────────────

      match /pulses/{pulseId} {
        // Only Circle members can see Pulses.
        allow read: if isCircleMember(circleId);

        // Create or update (upsert): user can only write their own Pulse for
        // today, enforced by the document ID format yyyyMMdd_userId.
        allow create, update: if isCircleMember(circleId)
          && request.resource.data.id == pulseId
          && request.resource.data.circleId == circleId
          && request.resource.data.userId == request.auth.uid
          && pulseId.matches('^[0-9]{8}_' + request.auth.uid + '$')
          // Photo URL must be provided.
          && request.resource.data.photoUrl is string
          && request.resource.data.photoUrl.size() >= 1;

        // A user may delete their own Pulse.
        allow delete: if isCircleMember(circleId)
          && resource.data.userId == request.auth.uid;
      }

      // ── /circles/{circleId}/plans/{planId} ───────────────────────────────

      match /plans/{planId} {
        // Only Circle members can see Plans.
        allow read: if isCircleMember(circleId);

        // Any Circle member can create a Plan.
        allow create: if isCircleMember(circleId)
          && request.resource.data.id == planId
          && request.resource.data.circleId == circleId
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.status == 'active'
          // Response counts must be zeroed on creation.
          && request.resource.data.inCount == 0
          && request.resource.data.maybeCount == 0
          && request.resource.data.cantCount == 0
          && request.resource.data.title is string
          && request.resource.data.title.size() >= 1;

        // Permitted plan updates – three cases:
        //
        // Case 1 – Response-count adjustment: any member may update the count
        //          fields, proven consistent with the staged response document.
        // Case 2 – Creator edit: the creator may update editable content fields.
        // Case 3 – Creator cancel: the creator may flip status to 'cancelled'.
        allow update: if (
            isCircleMember(circleId)
            && changedOnly(['inCount', 'maybeCount', 'cantCount', 'updatedAt'])
            && validPlanCountUpdate(circleId, planId)
          ) || (
            isCircleMember(circleId)
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'active'
            && changedOnly(['title', 'description', 'location', 'startsAt', 'updatedAt'])
            && request.resource.data.title is string
            && request.resource.data.title.size() >= 1
          ) || (
            isCircleMember(circleId)
            && resource.data.createdBy == request.auth.uid
            && resource.data.status == 'active'
            && changedOnly(['status', 'updatedAt'])
            && request.resource.data.status == 'cancelled'
          );

        // Plans cannot be deleted via the client.
        allow delete: if false;

        // ── /circles/{circleId}/plans/{planId}/responses/{userId} ──────────

        match /responses/{userId} {
          // All Circle members can see who responded and how.
          allow read: if isCircleMember(circleId);

          // A member may create or update their own response.
          // The plan's count fields must be updated in the same transaction.
          allow create, update: if isCircleMember(circleId)
            && isSelf(userId)
            && request.resource.data.userId == userId
            && request.resource.data.response in ['in', 'maybe', 'cant']
            && validPlanCountsAfterResponse(circleId, planId, userId);

          // Responses cannot be deleted.
          allow delete: if false;
        }
      }
    }

    // ─────────────────────────────────────────────────────────────────────────
    // Collection-group: members
    //
    // Allows the Home screen to query collectionGroup('members').where('userId')
    // to find all Circles a user belongs to. The rule is scoped to documents
    // where the stored userId matches the requester, so no cross-user leakage.
    // ─────────────────────────────────────────────────────────────────────────

    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
