{
  "name": "circleplus-rules-tests",
  "version": "1.0.0",
  "description": "Firestore security-rule tests for CirclePlus using @firebase/rules-unit-testing",
  "private": true,
  "scripts": {
    "test": "jest --forceExit --testTimeout=15000",
    "test:watch": "jest --watch --forceExit",
    "build": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^3.0.0",
    "@types/jest": "^29.5.12",
    "firebase-admin": "^12.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "typescript": "^7.0.2"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "testMatch": [
      "**/src/**/*.test.ts"
    ],
    "globals": {
      "ts-jest": {
        "tsconfig": "tsconfig.json"
      }
    }
  }
}
